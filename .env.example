# London Kids Preschool Avalurpet - Environment Variables
# For Local Development: copy this to .env.local
# For Vercel Production: Add these under Project Settings -> Environment Variables

# MongoDB Connection String
# Local: mongodb://127.0.0.1:27017/londonkids_preschool
# Vercel / Cloud: Free MongoDB Atlas Cluster (mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/londonkids_preschool?retryWrites=true&w=majority)
MONGODB_URI=mongodb://127.0.0.1:27017/londonkids_preschool

# Base Web Application URL (Optional, defaults to current host)
# Local: http://localhost:3000
# Vercel: https://london-kids-preschool-avalurpet.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare Turnstile CAPTCHA (Optional - dev test keys built-in)
# NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
